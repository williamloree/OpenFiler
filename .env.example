# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-random-string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Database (SQLite by default, can be changed to PostgreSQL/MySQL)
DATABASE_URL=./openfiler.db

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token API de référence (optionnel)
# Si défini, ce token est accepté pour les uploads sans passer par l'interface.
# Il n'apparaît pas dans l'application et ne peut pas être supprimé.
# OPENFILER_API_TOKEN=
